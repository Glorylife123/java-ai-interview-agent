<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.interviewagent.mapper.InterviewReportMapper">

    <insert id="insert" parameterType="com.example.interviewagent.entity.InterviewReport"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO interview_report (
            session_id, overall_score, summary,
            dimension_scores_json, suggestions_json, generator_type
        )
        VALUES (
            #{sessionId}, #{overallScore}, #{summary},
            #{dimensionScoresJson}, #{suggestionsJson}, #{generatorType}
        )
    </insert>

    <select id="selectBySessionId" resultType="com.example.interviewagent.entity.InterviewReport">
        SELECT *
        FROM interview_report
        WHERE session_id = #{sessionId}
    </select>

    <delete id="deleteBySessionId">
        DELETE FROM interview_report
        WHERE session_id = #{sessionId}
    </delete>

</mapper>
