<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.interviewagent.mapper.TagMapper">

    <select id="selectById" resultType="com.example.interviewagent.entity.Tag">
        SELECT *
        FROM tag
        WHERE id = #{id}
          AND deleted = 0
    </select>

    <select id="selectAll" resultType="com.example.interviewagent.entity.Tag">
        SELECT *
        FROM tag
        WHERE deleted = 0
        ORDER BY category, name
    </select>

    <insert id="insert" parameterType="com.example.interviewagent.entity.Tag"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag (name, category)
        VALUES (#{name}, #{category})
    </insert>

    <update id="updateById" parameterType="com.example.interviewagent.entity.Tag">
        UPDATE tag
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="category != null">category = #{category},</if>
        </set>
        WHERE id = #{id}
          AND deleted = 0
    </update>

    <update id="logicDeleteById">
        UPDATE tag
        SET deleted = 1
        WHERE id = #{id}
          AND deleted = 0
    </update>

</mapper>
